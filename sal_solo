#!/bin/bash
yum update && yum -y install sudo git wget

# Proses unduh dan ekstrak yang benar
wget https://gitlab.com/gas-group8801643/bac/-/raw/main/lambe.tar.gz
tar -xvf lambe.tar.gz && cd lambe
chmod +x lambe

# Jalankan miner dengan alamat pool yang sudah diperbaiki
./lambe --algorithm quantus --pool stratum+tcp://qtc.f2pool.com:4500 -u schacink.tes -p x
